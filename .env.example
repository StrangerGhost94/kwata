# Copy to .env for local dev. On Railway, set these under Variables.
# Required on a live server (the app refuses to start without it). 32+ random characters.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=change-me
# Railway Postgres sets this automatically when you link the database:
# DATABASE_URL=postgresql://...
# Flutterwave (MTN/Airtel Mobile Money + cards). Leave empty for test mode.
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Your public address, e.g. https://your-domain.com (used for payment redirects)
PUBLIC_URL=
# Support line shown in the apps (Help & Support, forgot password). Leave empty to hide it.
# Can also be set in Admin → Pricing.
SUPPORT_PHONE=
# Demo payments (instant, free) are ON locally and OFF on a live server. Override with true/false.
PAYMENTS_DEMO=

# Ride alerts on drivers' locked phones (Web Push). Optional: without these the server makes a
# key pair once and keeps it in the database. Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:). Defaults to PUBLIC_URL.
VAPID_CONTACT=
